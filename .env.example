PORT=8080
ENV=development
REDIS_URL=redis://redis:6379/0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-min-32-chars-for-local-dev-only
SECRET_PHRASE=les quinze mots secrets de la phrase finale ici
ALLOWED_ORIGINS=http://localhost:5173,https://leveling-unite.vercel.app
# Dev : localhost | Prod via proxy Vercel : laisser vide (cookie first-party sur le front)
COOKIE_DOMAIN=localhost
# ENV=production active Secure=true + SameSite=None sur le cookie session (requis Vercel ↔ API)
MAX_ATTEMPTS_PER_DAY=2
MIN_ACCOUNT_AGE_DAYS=5
RATE_LIMIT_WINDOW_HOURS=24
# RFC3339 — ferme /validate et ouvre /feedback après cette date
SUBMISSION_DEADLINE=2026-08-28T21:10:00+02:00
